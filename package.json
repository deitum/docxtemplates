{
  "name": "@deitum/docxtemplates",
  "version": "1.0.1",
  "description": "Template-based docx report creation",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser.mjs",
  "jsdelivr": "./dist/browser.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/browser.mjs"
  ],
  "author": "Zvyagin Danila",
  "contributors": [
    "Guillermo Grau Panea"
  ],
  "license": "MIT",
  "keywords": [
    "docx",
    "office",
    "word",
    "ms-word",
    "report",
    "template"
  ],
  "homepage": "https://github.com/deitum/docxtemplates#readme",
  "bugs": {
    "url": "https://github.com/deitum/docxtemplates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deitum/docxtemplates.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "clean": "rimraf dist skills/*/agent/dist",
    "build": "npm run clean && rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && npm run check:types:node && npm run check:types:browser",
    "check:types:node": "attw --pack . --entrypoints .",
    "check:types:browser": "attw --pack . --entrypoints ./browser --profile esm-only",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:package",
    "prepack": "npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/sax": "^1.2.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "events": "^3.3.0",
    "globals": "^17.9.0",
    "magic-string": "^0.30.21",
    "mockdate": "^3.0.5",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "qrcode": "^1.5.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "util": "^0.12.5",
    "vitest": "^4.1.10",
    "vm-browserify": "^1.1.2"
  }
}
